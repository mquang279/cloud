# Local .terraform directory (provider binaries, modules)
**/.terraform/*

# .tfstate files (local state should not be in Git)
*.tfstate
*.tfstate.*
.obsidian

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which likely contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

*.img